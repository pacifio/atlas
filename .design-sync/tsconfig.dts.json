{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "rootDir": "..",
    "outDir": "../dist/types",
    "paths": { "@/*": ["../src/*"] },
    "types": []
  },
  "include": ["./entry.tsx", "../src/vite-env.d.ts"]
}
