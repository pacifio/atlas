# Dependencies
node_modules/
bun.lockb

# Build output
dist/
# Upstream's own `dist/` is part of the vendored Material Icon Theme, not our
# build output: `atlas-icon-theme` include_str!s this manifest, so a checkout
# without it does not compile.
!crates/atlas-icon-theme/vendor/material-icon-theme/dist/
# Staging dir for scripts/build-frontend.mjs (content-aware sync into dist/).
dist-next/
target/

# IDE
# Per-developer editor state stays out; the shared settings and extension
# recommendations are committed.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

.claude/
.atlas/
# The dev profile's `.atlas/` (`bun run dev:app`, see crates/atlas-profile).
.atlas-dev/
.agents/
skills-lock.json

# Markdown docs (working notes, PRDs, comparison docs) — except the ones that
# ship with the app. TELEMETRY.md is referenced from the telemetry module and
# from the consent toggle in Settings, so it has to be in the repo the user is
# pointed at.
*.md
!README.md
!CLAUDE.md
# A symlink to CLAUDE.md, for the agents that read AGENTS.md instead.
# Atlas's instruction sync leaves a linked AGENTS.md alone.
!AGENTS.md
!TELEMETRY.md
!CONTRIBUTING.md
!.github/SECURITY.md
!.github/CODE_OF_CONDUCT.md
!CONTEXT.md
!docs/architecture.md
# The map of docs/ itself.
!docs/README.md
!docs/adr/*.md
!docs/archive/*.md
!docs/archive/radix-to-base-ui/*.md
!docs/research/*.md
!docs/qa/*.md
!docs/reference/*.md
# How agents file and label Linear work; CLAUDE.md points every session here.
!docs/agents/issue-tracker.md
!docs/agents/linear-reference.md
# Requests to other teams (the server team's gateway changes): the desktop
# code cites them, so they have to be in the repo it lives in.
!docs/requests/*.md
# The bundled `atlas-self-configure` skill's content — `include_str!`'d into
# the binary at compile time (`commands/skills.rs`), so it has to ship from a
# fresh clone the same way the vendored Atlas Agent prompts below do.
!src-tauri/resources/**/*.md
# Third-party notices that travel with what we took from them (Apache-2.0
# §4(d)), e.g. the Pierre syntax colours in the Atlas theme.
!crates/atlas-theme/third-party/**/*.md
graphify-out/
# Local-only working folders (plans/specs + helper scripts)
plans/
scripts/release-macos.sh
.firecrawl/

# Stakpak session files
.stakpak/session*

# The vendored Atlas Agent engine is committed verbatim (#42). Without this, the
# broad `*.md` rule above silently drops the engine's baked system prompts
# (`core/*_prompt.md`), its guardian policy templates and its skill samples —
# 35 paths, most of them `include_str!`d at compile time. The tree would build
# from a working copy and fail from a fresh clone, which is the worst shape a
# vendoring bug can take.
!vendor/atlas-engine/**
# ...except build output, if anyone ever builds in-tree there.
vendor/atlas-engine/**/target/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/ds.css

# Python bytecode from the one-off scripts.
__pycache__/
