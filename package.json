{
  "name": "atlas",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel typecheck:app build:vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/with-posthog-env.mjs tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:app": "node scripts/with-posthog-env.mjs tauri build --target aarch64-apple-darwin --bundles app",
    "build:app:dmg": "bash scripts/build-dmg.sh arm",
    "build:app:dmg:arm": "bash scripts/build-dmg.sh arm",
    "build:app:dmg:intel": "bash scripts/build-dmg.sh intel",
    "build:app:win": "node scripts/with-posthog-env.mjs tauri build --target x86_64-pc-windows-msvc --bundles msi",
    "build:app:linux": "node scripts/with-posthog-env.mjs tauri build --config src-tauri/tauri.linux.conf.json",
    "lint": "oxlint src/ tests/ scripts/",
    "format": "oxfmt --write src/ tests/ scripts/",
    "format:check": "oxfmt --check src/ tests/ scripts/",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run tests/",
    "theme:keys": "node scripts/generate-theme-keys.mjs",
    "theme:pierre": "node scripts/theme-pierre.mjs",
    "theme:keys:check": "node scripts/generate-theme-keys.mjs --check",
    "settings:gen": "node scripts/generate-settings.mjs",
    "settings:gen:check": "node scripts/generate-settings.mjs --check",
    "icons:render": "node scripts/app-icons.mjs",
    "icons:check": "node scripts/app-icons.mjs --check",
    "test:rust": "bash scripts/test-rust.sh",
    "ci:local": "bun scripts/ci-local.mjs",
    "bump": "bash scripts/bump.sh",
    "debump": "bash scripts/debump.sh",
    "test:watch": "vitest",
    "typecheck": "bun run --parallel typecheck:app typecheck:test",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "clean:app": "bash scripts/clean-atlas-config.sh",
    "clean:app:dev": "bash scripts/clean-atlas-config.sh --dev",
    "clean:rust": "find . crates vendor -maxdepth 2 -path ./target -prune -o -type d -name target -prune -exec sh -c 'test -f \"$1/CACHEDIR.TAG\" && du -sh \"$1\" && rm -rf \"$1\"' _ {} \\;",
    "clean:rust:stale": "find src-tauri crates -mindepth 1 -maxdepth 2 -type d -name target -prune ! -path 'crates/atlas-kb-server/*' -exec sh -c 'test -f \"$1/CACHEDIR.TAG\" && du -sh \"$1\" && rm -rf \"$1\"' _ {} \\;",
    "prepare": "husky"
  },
