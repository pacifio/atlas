  },
  "resolutions": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0"
  },
  "patchedDependencies": {
    "@pierre/diffs@1.5.2": "patches/@pierre%2Fdiffs@1.5.2.patch"
  },
  "overrides": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0"
  },
  "lint-staged": {
    "{src,tests,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt --write",
      "oxlint"
    ],
    "{src,tests,scripts}/**/*.{json,css}": "oxfmt --write",
    "**/*.rs": "node scripts/rustfmt-staged.mjs"
  },
  "packageManager": "bun@1.4.4"
}
